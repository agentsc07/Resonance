FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 curl make build-essential && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && python -m spacy download en_core_web_sm && pip freeze > /requirements.lock
CMD ["cat", "/requirements.lock"]
